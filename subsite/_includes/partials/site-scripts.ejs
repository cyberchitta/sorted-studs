<%# Shadows SG's empty default. GLB infrastructure for <glb-pane>:
    Google's <model-viewer> custom element + the theme-aware src swapper
    that picks the dark or light GLB variant, and the reduced-motion
    switch that drops autoplay. All are no-ops on pages
    that contain no <model-viewer[data-glb-base]>. %>
<script type="module" src="https://cdn.jsdelivr.net/npm/@google/model-viewer@4.0.0/dist/model-viewer.min.js"></script>
<script>
  (function () {
    var root = document.documentElement;
    function apply() {
      var t = root.dataset.theme === 'dark' ? 'dark' : 'light';
      document.querySelectorAll('model-viewer[data-glb-base]').forEach(function (mv) {
        var themed = mv.dataset.glbBase.replace(/\.glb$/i, '-' + t + '.glb');
        if (mv.getAttribute('src') !== themed) mv.setAttribute('src', themed);
      });
    }
    // Wait for <model-viewer> to be defined before initial apply.
    // Setting src on un-upgraded instances races during model-viewer's
    // simultaneous-upgrade init and can flash the first GLB into all panes.
    if (window.customElements && customElements.whenDefined) {
      customElements.whenDefined('model-viewer').then(apply);
    } else {
      apply();
    }
    new MutationObserver(apply).observe(root, { attributes: true, attributeFilter: ['data-theme'] });

    // Reduced motion: no autoplay. Runs before <model-viewer> upgrades (the
    // module script is deferred), so a model loaded under the preference never
    // starts; a change while the page is open pauses or resumes.
    var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)');
    function motion() {
      document.querySelectorAll('model-viewer[data-glb-base]').forEach(function (mv) {
        if (reduce.matches) {
          mv.removeAttribute('autoplay');
          if (mv.pause) mv.pause();
        } else {
          mv.setAttribute('autoplay', '');
          if (mv.play && mv.loaded) mv.play();
        }
      });
    }
    if (reduce) {
      motion();
      if (reduce.addEventListener) reduce.addEventListener('change', motion);
    }
  })();
</script>
