<%# Container follows the house figure pattern (SG design-surface figures.md §1);
    `caption` is optional and lands in the <figcaption>. %>
<div class="not-prose bg-base-200 rounded-lg shadow-sm border border-base-300 overflow-hidden relative" style="margin: 2rem 0">
  <figure class="m-0">
    <div class="px-1 sm:px-4 py-1">
      <div class="overflow-hidden bg-base-100 rounded border border-base-300">
        <model-viewer
          data-glb-base="<%= src %>"
          alt="<%= alt %>"
          autoplay
          camera-controls
          camera-orbit="<%= orbit %>"
          touch-action="pan-y"
          interaction-prompt="none"
          environment-image="neutral"
          shadow-intensity="1"
          exposure="1.1"
          style="width: 100%; height: auto; aspect-ratio: 1 / 1; background: transparent;"
        ></model-viewer>
      </div>
    </div>
    <% if (typeof caption === 'string' && caption) { %>
    <figcaption class="px-1 sm:px-4 py-1 mt-0 mb-1" style="font-size: 0.8125rem; opacity: 0.7"><%= caption %></figcaption>
    <% } %>
  </figure>
</div>
