<figure class="pane pane-interactive my-6">
  <model-viewer
    data-glb-base="<%= src %>"
    alt="<%= alt %>"
    autoplay
    camera-controls
    camera-orbit="<%= orbit %>"
    touch-action="pan-y"
    interaction-prompt="none"
    shadow-intensity="1"
    exposure="1.1"
    style="width: 100%; height: auto; aspect-ratio: 1 / 1; background: transparent;"
  ></model-viewer>
</figure>
